ing, dispensing, singing, there I wander with them,\nPlucking something for tokens, tossing toward whoever is near me,\nHere, lilac, with a branch of pine,\nHere, out of my pocket, some moss which I pull'd off a live-oak in Florida as it hung trailing down,\nHere, some pinks and laurel leaves, and a handful of sage,\nAnd here what I now draw from the water, wading in the pond-side,\n(O here I last saw him that tenderly loves me, and returns again never to separate from me,\nAnd this, O this shall henceforth be the token of comrades, this calamus-root shall,\nInterchange it youths with each other! "},{"en":[["let","","s"]," ",["none","","s"]," ",["render","","p"]," ",["it","","o"]," ",["back","","o"],"!)","\n "],"zh":[["谁","shuí","s"],["也","yě","d"],["不","bù","a"],["要","yào","a"],["把","bǎ","d"],["它","tā","a"],["退","tuì","a"],["回","huí","a"],["去","qù","c"],"！）"],"ja":[["誰","だれ","s"],["もそれを","","o"],["返","かえ","a"],["してはならない！）","","s"]],"src":"let none render it back!)\n "},{"en":[["And","","f"]," ",["twigs","","s"]," ",["of","","a"]," ",["maple","","s"]," ",["and","","f"]," ",["a","","a"]," ",["bunch","","s"]," ",["of","","a"]," ",["wild","","s"]," ",["orange","","s"]," ",["and","","f"]," ",["chestnut","","s"],",","\n",["And","","f"]," ",["stems","","s"]," ",["of","","a"]," ",["currants","","s"]," ",["and","","f"]," ",["plum-blows","","s"],","," ",["and","","f"]," ",["the","","a"]," ",["aromatic","","s"]," ",["cedar","","s"],",","\n",["These","","a"]," ",["I","","s"]," ",["compass'd","","s"]," ",["around","","d"]," ",["by","","d"]," ",["a","","d"]," ",["thick","","d"]," ",["cloud","","d"]," ",["of","","a"]," ",["spirits","","s"],",","\n",["Wandering","","p"],","," ",["point","","o"]," ",["to","","d"]," ",["or","","f"]," ",["touch","","o"]," ",["as","","o"]," ",["I","","o"]," ",["pass","","o"],","," ",["or","","f"]," ",["throw","","o"]," ",["them","","o"]," ",["loosely","","o"]," ",["from","","d"]," ",["me","","d"],","],"zh":[["还","hái","d"],["有","yǒu","p"],["几","jǐ","o