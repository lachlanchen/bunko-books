they are good.\n Those corpses of young men,\nThose martyrs that hang from the gibbets, those hearts pierc'd by the gray lead,\nCold and motionless as they seem live elsewhere with unslaughter'd vitality.\n They live in other young men O kings!","u":[{"en":[["Europe","","s"],"\n",["The","","a"]," ",["72","","s"],["d","","s"]," ",["and","","f"]," ",["73","","s"],["d","","s"]," ",["Years","","s"]," ",["of","","a"]," ",["These","","a"]," ",["States","","s"],"\n",["Suddenly","","s"]," ",["out","","s"]," ",["of","","a"]," ",["its","","a"]," ",["stale","","s"]," ",["and","","f"]," ",["drowsy","","s"]," ",["lair","","s"],","," ",["the","","a"]," ",["lair","","s"]," ",["of","","a"]," ",["slaves","","s"],",","\n",["Like","","s"]," ",["lightning","","p"]," ",["it","","o"]," ",["le'pt","","o"]," ",["forth","","o"]," ",["half","","o"]," ",["startled","","p"]," ",["at","","d"]," ",["itself","","d"],",","\n",["Its","","d"]," ",["feet","","d"]," ",["upon","","d"]," ",["the","","d"]," ",["ashes","","d"]," ",["and","","f"]," ",["the","","a"]," ",["rags","","o"],","," ",["its","","a"]," ",["hands","","o"]," ",["tight","","o"]," ",["to","","d"]," ",["the","","d"]," ",["throats","","d"]," ",["of","","a"]," ",["kings","","o"],".","\n "],"zh":[["欧","ōu","s"],["罗","luó","s"],["巴","bā","s"]," （",["合","hé","s"],["众","zhòng","s"],["国","guó","s"],["的","de","a"],["第","dì","s"],["七","qī","s"],["十","shí","s"],["二","èr","s"],["年","nián","s"],["和","hé","s"],["第","dì","s"],["七","qī","s"],["十","shí","s"],["三","sān","a"],["年","nián","a"]," ） ",["突","tū","a"],["然","rán","d"],["从","cóng","d"],["它","tā","a"],["陈","chén","a"],["腐","fǔ","a"],["而","ér","a"],["昏","hūn","a"],["睡","shuì","p"],["的","de","a"],["巢","cháo","o"],["穴","xué","o"],"，",["奴","nú","o"],["隶","lì","o"],["的","de","a"],["巢","cháo","o"],["穴","xué","o"],["中","zhōng","o"],"， ",["它","tā","o"],["像","xiàng","o"],["闪","shǎn","o"],["电","diàn","o"],["一","yī","o"],["样","yàng","o"],["跳","tiào","o"],["了","le","c"],["出","chū","c"],["来","lái","c"],"，",["