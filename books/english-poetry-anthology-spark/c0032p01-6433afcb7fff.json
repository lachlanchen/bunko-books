y son in his grave, in his rude-dug grave I deposited,\nEnding my vigil strange with that, vigil of night and battle-field dim,\nVigil for boy of responding kisses, (never again on earth responding,)","u":[{"en":[["Vigil","","s"]," ",["strange","","s"]," ",["I","","s"]," ",["kept","","s"]," ",["on","","d"]," ",["the","","d"]," ",["field","","d"]," ",["one","","d"]," ",["night","","d"],";","\n",["When","","f"]," ",["you","","d"]," ",["my","","d"]," ",["son","","d"]," ",["and","","f"]," ",["my","","a"]," ",["comrade","","s"]," ",["dropt","","s"]," ",["at","","d"]," ",["my","","d"]," ",["side","","d"]," ",["that","","f"]," ",["day","","s"],",","\n",["One","","s"]," ",["look","","p"]," ",["I","","o"]," ",["but","","f"]," ",["gave","","p"]," ",["which","","o"]," ",["your","","a"]," ",["dear","","o"]," ",["eyes","","o"]," ",["return'd","","o"]," ",["with","","d"]," ",["a","","d"]," ",["look","","p"]," ",["I","","o"]," ",["shall","","p"]," ",["never","","o"]," ",["forget","","o"],",","\n",["One","","o"]," ",["touch","","o"]," ",["of","","a"]," ",["your","","a"]," ",["hand","","o"]," ",["to","","d"]," ",["mine","","d"]," ",["O","","d"]," ",["boy","","d"],","," ",["reach'd","","d"]," ",["up","","d"]," ",["as","","d"]," ",["you","","d"]," ",["lay","","d"]," ",["on","","d"]," ",["the","","d"]," ",["ground","","d"],",","\n",["Then","","d"]," ",["onward","","d"]," ",["I","","d"]," ",["sped","","p"]," ",["in","","d"]," ",["the","","d"]," ",["battle","","d"],","," ",["the","","d"]," ",["even-contested","","p"]," ",["battle","","o"],",","\n",["Till","","o"]," ",["late","","o"]," ",["in","","d"]," ",["the","","d"]," ",["night","","d"]," ",["reliev'd","","d"]," ",["to","","d"]," ",["the","","d"]," ",["place","","d"]," ",["at","","d"]," ",["last","","d"]," ",["again","","d"]," ",["I","","d"]," ",["made","","p"]," ",["my","","a"]," ",["way","","o"],",","\n",["Found","","o"]," ",["you","","o"]," ",["in","","d"]," ",["death","","d"]," ",["so","","f"]," ",["cold","","o"]," ",["dear","","o