on,\nWere distant still. An old man cocked his ear.\n Aherne. What made that sound?\n Robartes. A rat or water-hen\nSplashed, or an otter slid into the stream.\n We are on the bridge; that shadow is the tower, 10\nAnd the light proves that he is reading still.\n He has found, after the manner of his kind,\nMere images; chosen this place to live in\nBecause, it may be, of the candle-light\nFrom the far tower where Milton's Platonist\nSat late, or Shelley's visionary prince:\nThe lonely light that Samuel Palmer engraved,\nAn image of mysterious wisdom won by toil;\nAnd now he seeks in book or manuscript\nWhat he shall never find. ","u":[{"en":[["The","","a"]," ",["Phases","","s"]," ",["of","","a"]," ",["the","","a"]," ",["Moon","","s"],"\n",["An","","a"]," ",["old","","s"]," ",["man","","s"]," ",["cocked","","p"]," ",["his","","a"]," ",["ear","","o"]," ",["upon","","o"]," ",["a","","a"]," ",["bridge","","o"],";","\n",["He","","o"]," ",["and","","f"]," ",["his","","a"]," ",["friend","","o"],","," ",["their","","a"]," ",["faces","","o"]," ",["to","","d"]," ",["the","","d"]," ",["South","","d"],",","\n",["Had","","p"]," ",["trod","","o"]," ",["the","","a"]," ",["uneven","","o"]," ",["road","","o"],"."," "],"zh":[["月","yuè","s"],["相","xiāng","s"],"。 ",["一","yī","s"],["位","wèi","s"],["老","lǎo","s"],["人","rén","s"],["在","zài","d"],["桥","qiáo","a"],["上","shàng","p"],["侧","cè","a"],["耳","ěr","a"],["倾","qīng","a"],["听","tīng","p"],"；",["他","tā","o"],["和","hé","o"],["同","tóng","o"],["伴","bàn","o"],["都","dōu","d"],["朝","cháo","o"],["南","nán","o"],["方","fāng","d"],"，",["走","zǒu","p"],["过","guò","c"],["那","nà","o"],["起","qǐ","c"],["伏","fú","o"],["不","bù","o"],["平","píng","o"],["的","de","a"],["路","lù","o"],"。"],"ja":[["月","がつ","s"],["の","","a"],["暁","あかつき","s"],["（つきの","","a"],["相","そう","s"],["）。 ある","","p"],["老","ろう","s"],["人","じん","a"],["が","","s"],["橋","はし","a"],["の","","a"],["上","うえ","a"],["で","","d"],["耳","みみ","a"],["をそばだてていた。","","o"],["彼","かれ","a"],["と","","d"],["友","とも","a"