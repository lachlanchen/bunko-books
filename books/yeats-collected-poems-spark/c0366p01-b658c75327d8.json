wned the treasures of nine conquered nations,\nAnd blew me hither to my lasting sorrow,\nHad drowned me also. But, being yet alive,\nI ask a fitting punishment for all 290\nThat raised their hands against him.\n Forgael. There are some\nThat weigh and measure all in these waste seas -\nThey that have all the wisdom that's in life,\nAnd all that prophesying images\nMade of dim gold rave out in secret tombs;\nThey have it that the plans of kings and queens\nAre dust on the moth's wing; that nothing matters\nBut laughter and tears - laughter, laughter, and tears;","u":[{"en":[["Dectora","","p"],"."," "],"zh":[["德","dé","s"],["科","kē","t"],["塔","tǎ","o"],"。"],"ja":[["デクトラ。","","o"]],"src":"Dectora. "},{"en":[["I","","s"]," ",["am","","p"]," ",["a","","a"]," ",["queen","","o"],",","\n",["And","","f"]," ",["ask","","o"]," ",["for","","f"]," ",["satisfaction","","o"]," ",["upon","","o"]," ",["these","","a"],"\n",["Who","","o"]," ",["have","","p"]," ",["slain","","o"]," ",["my","","a"]," ",["husband","","o"]," ",["and","","f"]," ",["laid","","o"]," ",["hands","","o"]," ",["upon","","o"]," ",["me","","o"],".","\n "],"zh":[["我","wǒ","s"],["是","shì","p"],["一","yī","o"],["位","wèi","o"],["女","nǚ","o"],["王","wáng","o"],"， ",["对","duì","o"],["这","zhè","o"],["些","xiē","o"],["人","rén","o"],["索","suǒ","o"],["取","qǔ","o"],["偿","cháng","o"],["还","hái","d"],"， ",["因","yīn","d"],["为","wèi","o"],["他","tā","o"],["们","men","o"],["杀","shā","o"],["了","le","c"],["我","wǒ","o"],["的","de","a"],["丈","zhàng","o"],["夫","fū","o"],["并","bìng","d"],["动","dòng","o"],["手","shǒu","o"],["害","hài","o"],["我","wǒ","o"],"。"],"ja":[["私","わたし","s"],["は","","s"],["女","じょ","s"],["王","おう","s"],["である。 ","","d"],["私","わたし","s"],["の","","a"],["夫","おっと","a"],["を","","o"],["殺","ころ","a"],["し、","","a"],["私","わたし","a"],["に","","d"],["手","て","a"],["を","","o"],["下","くだ","a"],["した","","p"],["者","もの","o"],["たちに","","d"],["対","たい","o"],["して、 ","","o"],["相","そう","o"],["応","おう","c"],["の","","a"],["報","むく","c"],["いを","","o"],["求",