{"id":"poem-0203-p1","n":203,"title":{"en":[["230","","s"]," ",["LYRICAL","","p"]],"zh":[["苇","wěi","s"],["间","jiān","t"],["风","fēng","o"]],"ja":[["第","だい","s"],["203","","a"],["章","しょう","c"]]},"p":[{"id":"yeats-collected-poems-s0203-p00429","src":"No living man can drink from the whole wine.\n I have mummy truths to tell\nWhereat the living mock,\nThough not for sober ear,\nFor maybe all that hear\nShould laugh and weep an hour upon the clock. go\nSuch thought - such thought have I that hold it tight\nTill meditation master all its parts,\nNothing can stay my glance\nUntil that glance run in the world's despite\nTo where the damned have howled away their hearts,\nAnd where the blessed dance;\nSuch thought, that in it bound\nI need no other thing,\nWound in mind's wandering\nAs mummies in the mummy-cloth are wound. ","u":[{"en":[["No","","s"]," ",["living","","p"]," ",["man","","o"]," ",["can","","p"]," ",["drink","","o"]," ",["from","","d"]," ",["the","","d"]," ",["whole","","d"]," ",["wine","","d"],".","\n "],"zh":[["世","shì","s"],["上","shàng","p"],["没","méi","s"],["有","yǒu","p"],["一","yī","o"],["个","gè","o"],["活","huó","p"],["着","zhe","c"],["的","de","a"],["人","rén","o"],["能","néng","o"],["喝","hē","o"],["尽","jǐn","o"],["这","zhè","o"],["整","zhěng","o"],["杯","bēi","o"],["酒","jiǔ","o"],"。"],"ja":[["生","い","s"],["きている","","p"],["者","もの","o"],["にとって、このワインをひとつぶんすべて","","o"],["飲","の","c"],["むことはできない。","","s"]],"src":"No living man can drink from the whole wine.\n "},{"en":[["I","","s"]," ",["have","","p"]," ",["mummy","","o"]," ",["truths","","o"]," ",["to","","d"]," ",["tell","","p"],"\n",["Whereat","","o"]," ",["the","","a"]," ",["living","","p"]," ",["mock","","o"],",","\n",["Though","","f"]," ",["not","","d"]," ",["for","","f"]," ",["sober","","o"]," ",["ear","","o"],",","\n",["For","","f"]," ",["maybe","","o"]," ",["all","","o"]," ",["that","","f"]," ",["hear","","o"],"\n",["Should","","p"]," ",["laugh","","o"]," ",["and","","f"]," ",["weep","","o"]," ",["an","","a"