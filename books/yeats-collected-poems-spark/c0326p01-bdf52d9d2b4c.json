e ancient things."}]},{"id":"yeats-collected-poems-s0326-p00678","src":",'Neither the living, nor the unlabouring dead,\nNor the high gods who never lived, may fight So\nMy enemy and hope; demons for fright\nJabber and scream about him in the night;\nFor he is strong and crafty as the seas\nThat sprang under the Seven Hazel Trees,\nAnd I must needs endure and hate and weep,\nUntil the gods and demons drop asleep,\nHearing Aed touch the mournful strings of gold.'\n'Is he so dreadful?'\n'Be not over-bold,\nBut fly while still you may.'\nAnd thereon I:\n'This demon shall be battered till he die, go\nAnd his loose bulk be thrown in the loud tide.'","u":[{"en":[",'",["Neither","","s"]," ",["the","","a"]," ",["living","","p"],","," ",["nor","","f"]," ",["the","","a"]," ",["unlabouring","","p"]," ",["dead","","o"],",","\n",["Nor","","f"]," ",["the","","a"]," ",["high","","o"]," ",["gods","","o"]," ",["who","","o"]," ",["never","","o"]," ",["lived","","p"],","," ",["may","","p"]," ",["fight","","o"]," ",["So","","f"],"\n",["My","","a"]," ",["enemy","","o"]," ",["and","","f"]," ",["hope","","o"],";"," ",["demons","","o"]," ",["for","","f"]," ",["fright","","o"],"\n",["Jabber","","o"]," ",["and","","f"]," ",["scream","","o"]," ",["about","","d"]," ",["him","","d"]," ",["in","","d"]," ",["the","","d"]," ",["night","","d"],";","\n",["For","","f"]," ",["he","","o"]," ",["is","","p"]," ",["strong","","o"]," ",["and","","f"]," ",["crafty","","o"]," ",["as","","o"]," ",["the","","a"]," ",["seas","","o"],"\n",["That","","f"]," ",["sprang","","o"]," ",["under","","d"]," ",["the","","d"]," ",["Seven","","d"]," ",["Hazel","","d"]," ",["Trees","","d"],",","\n",["And","","f"]," ",["I","","o"]," ",["must","","p"]," ",["needs","","o"]," ",["endure","","o"]," ",["and","","f"]," ",["hate","","p"]," ",["and","","f"]," ",["weep","","o"],",","\n",["Until","","o"]," ",["the","","a"]," ",["gods","","o"]," ",["and","","f"]," ",["demons","","o"]," ",["drop","","o"]," ",["asleep","","o"],",","\n",["