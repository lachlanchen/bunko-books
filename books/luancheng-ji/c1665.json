聖恩除臣試中書舍人者。頃蒙特指召試中堂，辭避不從，黽勉而就，遂忝成命，意終不安。雖知區區寸誠，不能仰回天聽，而匹夫之志，終欲必行。蓋人臣事君，本求知遇，有命不受，近於不情。然臣以義而言，有三不可：伏念臣少從父學，稍知為文，憂患以來，筆硯都廢。今雖勉強，心志已衰。此一不可也。臣昨自縣道召充諫官，旋叨左史，仍兼詞命，駢繁寵數，並在一年。臣猶知非，況復公議。此二不可也。內外兩制，素號要途，兄軾頃已擢在禁林，臣今安敢復據西掖。非獨畏避譏評，實亦恐懼盈滿。此三不可也。臣既無一堪，而有三不可，冒昧寵祿，將安用之。伏乞聖慈，鑒臣愚誠，特寢前命，俾臣得安閑地，少弭人言，則臣圖報恩私，尚有他日。謹具狀奏聞，伏候敕旨。","u":[{"wenyan":[["右","yòu","s"],["臣","chén","s"],["今","jīn","a"],["月","yuè","a"],["某","mǒu","s"],["日","rì","s"],["准","zhǔn","p"],["閣","gé","a"],["門","mén","a"],["告","gào","p"],["報","bào","a"],"，",["蒙","méng","p"],["聖","shèng","f"],["恩","ēn","o"],["除","chú","f"],["臣","chén","d"],["試","shì","f"],["中","zhōng","o"],["書","shū","a"],["舍","shě","o"],["人","rén","o"],["者","zhě","o"],"。"],"zh_modern":[["臣","chén","s"],["本","běn","s"],["月","yuè","s"],["某","mǒu","s"],["日","rì","s"],["接","jiē","p"],["到","dào","f"],["閣","gé","a"],["門","mén","a"],["的","de","f"],["通","tōng","p"],["知","zhī","p"],"，",["承","chéng","o"],["蒙","méng","o"],["聖","shèng","f"],["恩","ēn","o"],["任","rèn","o"],["命","mìng","o"],["臣","chén","o"],["為","wèi","a"],["試","shì","f"],["中","zhōng","o"],["書","shū","a"],["舍","shě","o"],["人","rén","o"],"。"],"ja_modern":[["臣","しん","s"],["は","","f"],["今月某日","こんげつぼうじつ","s"],"、",["閣門","かくもん","s"],["の","","f"],["知","し","o"],["らせ","","o"],["を","","f"],["受","う","p"],["け","","p"],"、",["聖恩","せいおん","d"],["に","","f"],["より","","p"],["試中書舍人","しちゅうしょしゃにん","o"],["に","","f"],["任","にん","p"],["じ","","p"],["られ","","p"],["まし","","p"],["た","","p"],"。"],"en":[["Your","","a"]," ",["servant","","s"]," ",["received","","p"]," ",["notice","","d"]," ",["from","","f"]," ",["the","","a"]," ",["Palace","","o"]," ",["Gate","","o"]," ",["on","","f"]," ",["a","","a"]," ",["certain","","a"]," ",["day","","o"]," ",["this","","a"]," ",["month","","o"]," ",["that","","f"],","," ",["by","","f"]," ",["imperial","","a"]," ",["favor","","t"],","," ",["he","","s"]," ",["has","","p"]," ",["been","","p"]," ",["appointed","","p"]," ",["Acting","","o"]," ",["Secretariat","","o"]," ",["Drafter","","o"],"."],"src":"右臣今月某日