n,\nThe lips that sang of Heaven and of Hell,\nThe almond-face which Giotto drew so well,\nThe weary face of Dante;⁠—to this day,\nHere in his place of resting, far away\nFrom Arno’s yellow waters, rushing down\nThrough the wide bridges of that fairy town,\nWhere the tall tower of Giotto seems to rise\nA marble lily under sapphire skies!\n Alas! my Dante! thou hast known the pain\nOf meaner lives⁠—the exile’s galling chain,\nHow steep the stairs within kings’ houses are,\nAnd all the petty miseries which mar\nMan’s nobler nature with the sense of wrong.","u":[{"en":[["Mighty","","s"]," ",["indeed","","p"]," ","*",["their","","a"],"*"," ",["glory","","o"],"!"," "],"zh":[["他","tā","s"],["们","men","s"],["的","de","a"],["荣","róng","a"],["耀","yào","a"],"，",["的","de","a"],["确","què","a"],["是","shì","p"],["强","qiáng","o"],["盛","shèng","o"],["的","de","a"],"！"],"ja":[["その","","a"],["栄","えい","s"],["光","こう","a"],["は、まことに","","s"],["荘","そう","a"],["厳","ごん","a"],["であった。","","d"]],"src":"Mighty indeed *their* glory! "},{"en":[["yet","","f"]," ",["to","","d"]," ",["me","","d"],"\n",["Barbaric","","d"]," ",["king","","p"],","," ",["or","","f"]," ",["knight","","o"]," ",["of","","a"]," ",["chivalry","","o"],",","\n",["Or","","f"]," ",["the","","a"]," ",["great","","o"]," ",["queen","","o"]," ",["herself","","o"],","," ",["were","","p"]," ",["poor","","o"]," ",["and","","f"]," ",["vain","","o"],",","\n",["Beside","","d"]," ",["the","","d"]," ",["grave","","d"]," ",["where","","d"]," ",["Dante","","d"]," ",["rests","","d"]," ",["from","","d"]," ",["pain","","d"],".","\n "],"zh":[["然","rán","d"],["而","ér","s"],["在","zài","d"],["我","wǒ","s"],["看","kàn","p"],["来","lái","c"],"，",["蛮","mán","o"],["族","zú","o"],["之","zhī","o"],["王","wáng","o"],"，",["或","huò","o"],["骑","qí","o"],["士","shì","o"],["道","dào","o"],["的","de","a"],["骑","qí","o"],["士","shì","o"],"，",["甚","shèn","o"],["至","zhì","o"],["伟","wěi","o"],["大","dà","o"],["的","de","a"],["王","wáng","o"],["后","hòu","o"],["本","běn","o"],["人","ré