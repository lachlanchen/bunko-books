乃縱神力，建立寶階，中階黃金，左水精，右白銀。如來起善法堂，從諸天眾，履中階而下；大梵王執白拂，履銀階而右侍；天帝釋持寶蓋，蹈水精階而左侍。天眾淩虛，散花贊德。數百年前，猶有階級，逮至今時，陷沒已盡。諸國君王悲慨不遇，壘以磚石，飾以珍寶，於其故基，擬昔寶階，其高七十餘尺，上起精舍。中有石佛像，而左右之階有釋、梵之像，形擬厥初，猶為下勢。傍有石柱，高七十餘尺，無憂王所建。色紺光潤，質堅密理，上作師子蹲踞向階，雕鏤奇形，周其方面，隨人罪福，影現柱中。","u":[{"wenyan":[["伽","gā","a"],["藍","lán","f"],["大","dà","a"],["垣","yuán","s"],["內","nèi","a"],["有","yǒu","p"],["三","sān","o"],["寶","bǎo","a"],["階","jiē","f"],"，",["南","nán","o"],["北","běi","o"],["列","liè","p"],"，",["東","dōng","a"],["面","miàn","o"],["下","xià","o"],"，",["是","shì","p"],["如","rú","p"],["來","lái","a"],["自","zì","f"],["三","sān","d"],["十","shí","d"],["三","sān","d"],["天","tiān","d"],["降","jiàng","p"],["還","hái","f"],["所","suǒ","f"],["也","yě","d"],"。"],"zh_modern":[["寺","sì","a"],["院","yuàn","a"],["的","de","f"],["大","dà","a"],["围","wéi","s"],["墙","qiáng","s"],["内","nèi","s"],["有","yǒu","p"],["三","sān","o"],["道","dào","o"],["宝","bǎo","o"],["阶","jiē","o"],"，",["南","nán","o"],["北","běi","o"],["并","bìng","p"],["列","liè","p"],"，",["向","xiàng","f"],["东","dōng","o"],["而","ér","f"],["下","xià","o"],"，",["这","zhè","o"],["里","lǐ","o"],["就","jiù","d"],["是","shì","p"],["如","rú","o"],["来","lái","p"],["从","cóng","f"],["三","sān","d"],["十","shí","d"],["三","sān","d"],["天","tiān","d"],["返","fǎn","p"],["回","huí","p"],["人","rén","o"],["间","jiān","o"],["时","shí","o"],["降","jiàng","p"],["临","lín","p"],["的","de","f"],["地","dì","f"],["方","fāng","o"],"。"],"ja_modern":[["寺院","じいん","a"],["の","","f"],["大","おお","a"],["きな","","a"],["境内","けいだい","d"],["に","","f"],["は","","f"],"、",["南北","なんぼく","d"],["に","","f"],["並","なら","p"],["び","","p"],"、",["東","ひがし","d"],["へ","","f"],["下","くだ","p"],["る","","p"],["三","みっ","o"],["つ","","a"],["の","","f"],["宝","たから","a"],["の","","f"],["階段","かいだん","s"],["が","","f"],["ある","","p"],"。",["ここ","","s"],["は","","f"],["如来","にょらい","s"],["が","","f"],["三十三天","さんじゅうさんてん","o"],["から","","f"],["人間界","にんげんかい","o"],["へ","","f"],["戻","もど","p"],["る","","p"],["際","さい","d"],["に","","f"],["降り立","おりた","p"],["っ","","p"],["た","","p"],["場所","ばしょ","d"],["で","","